{
  "name": "mern-proshop",
  "version": "1.0.0",
  "description": "E-Commerce application built with mern stack",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node backend/server.js",
    "server": "nodemon backend/server.js",
    "client": "npm start --prefix frontend",
    "dev": "concurrently \"npm run server \"  \"npm run client \"",
    "data:destroy": "node backend/seeder -d",
    "data:import": "node backend/seeder -i"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haider-shaikh-dev/mern-proshop.git"
  },
  "author": "Haider Ali Shaikh",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/haider-shaikh-dev/mern-proshop/issues"
  },
  "homepage": "https://github.com/haider-shaikh-dev/mern-proshop#readme",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "colors": "^1.4.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.2",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.2",
    "nodemon": "^3.1.10"
  }
}
